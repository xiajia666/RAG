pipeline {

    agent any

    stages {

        stage('拉取代码') {
            steps {
                git(
                    url: 'https://github.com/xiajia666/RAG.git',
                    branch: 'main'
                )
            }
        }


        stage('部署后端') {
            steps {

                sshagent(['a3e6c2a5-eb32-4b3d-bcc8-1eb8039c16d3']) {

                    sh '''
                    ssh -o StrictHostKeyChecking=no root@123.57.80.38 "

                    source /root/rag_backend/bin/activate

                    cd /root/RAG/backend &&

                    git pull &&

                    pip install -r /root/RAG/backend/requirements.txt

                    systemctl restart rag-backend &&

                    systemctl status rag-backend --no-pager

                    "
                    '''

                }

            }
        }
    }
}